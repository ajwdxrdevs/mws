{
  "name": "@whatsapp-blast/database",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate --config=drizzle.config.cjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.cjs",
    "db:push": "drizzle-kit push --config=drizzle.config.cjs",
    "db:push:force": "node push.js",
    "db:studio": "drizzle-kit studio --config=drizzle.config.cjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0",
    "mysql2": "^3.12.0",
    "postgres": "^3.4.5",
    "@paralleldrive/cuid2": "^2.2.2",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.3.0"
  }
}
